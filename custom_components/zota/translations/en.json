    "step": {
      "user": {
        "title": "ZOTA Net",
        "description": "Sign in to ZOTA Net. The app uses HTTP port 81: credentials travel without TLS. Enable the checkbox only if you accept this. MK-X communication uses cloud TCP without TLS. Password is used only for setup. Turning OFF the room thermostat stops the entire boiler.",
