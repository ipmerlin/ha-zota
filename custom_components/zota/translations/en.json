          "username": "Username",
          "password": "Password",
          "api_url": "Account API URL",
          "allow_http": "Allow account credentials over HTTP without TLS"
        }
      },
      "boiler": {
        "title": "Select MK-X",
        "description": "Only Internet-connected MK-X boilers are supported.",
        "data": {
          "boiler": "Boiler"
        }
      }
    },
